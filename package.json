{
  "bugs": {
    "url": "https://github.com/piro0919/next-subrouter/issues"
  },
  "description": "Next.js subdomain-based routing for middleware.ts and proxy.ts, with optional next-intl support",
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/compat": "2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.6",
    "@testing-library/react": "16.3.3",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "@uphold/commitlint-config": "1.1.1",
    "@vercel/analytics": "2.0.1",
    "better-typescript-lib": "2.12.0",
    "eslint": "^10.11.0",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-css": "0.12.0",
    "eslint-plugin-css-modules": "2.12.0",
    "eslint-plugin-ext": "0.1.0",
    "eslint-plugin-filenames": "1.3.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-perfectionist": "5.12.1",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-security": "4.1.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "eslint-plugin-write-good-comments": "0.2.0",
    "jsdom": "30.1.1",
    "lefthook": "2.1.15",
    "next": "16.3.8",
    "next-intl": "4.14.8",
    "next-sitemap": "4.2.3",
    "prettier": "3.9.9",
    "publint": "0.3.24",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ress": "6.0.0",
    "secretlint": "13.0.6",
    "stylelint": "17.15.0",
    "stylelint-config-css-modules": "4.6.0",
    "stylelint-config-recommended": "18.0.0",
    "stylelint-css-modules-no-global-scoped-selector": "1.0.2",
    "stylelint-declaration-block-no-ignored-properties": "3.0.0",
    "stylelint-high-performance-animation": "2.0.0",
    "stylelint-no-unused-selectors": "1.0.40",
    "stylelint-order": "8.1.1",
    "tsup": "8.5.1",
    "typescript": "^5.9.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://next-subrouter.kkweb.io",
  "funding": "https://github.com/sponsors/piro0919",
  "keywords": [
    "nextjs",
    "middleware",
    "subdomain",
    "routing",
    "i18n",
    "internationalization",
    "proxy"
  ],
  "author": "piro0919 <piro.haniwa@gmail.com> (https://kkweb.io/)",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "name": "next-subrouter",
  "overrides": {
    "stylelint-css-modules-no-global-scoped-selector": {
      "stylelint": "$stylelint"
    },
    "stylelint-no-unused-selectors": {
      "stylelint": "$stylelint"
    }
  },
  "peerDependencies": {
    "next": ">=13.5.11 <17",
    "react": "^18.0.0 || ^19.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piro0919/next-subrouter.git"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "build:demo": "next build",
    "dev": "next dev",
    "dev:demo": "next dev",
    "lefthook": "npx lefthook run pre-commit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:secret": "npx secretlint --maskSecrets '**/*'",
    "lint:style": "stylelint --fix '**/*.css'",
    "postbuild:demo": "next-sitemap",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm lint && pnpm type-check && pnpm test && pnpm build && pnpm check:package",
    "prettier": "prettier --write .",
    "secretlint": "secretlint '**/*'",
    "start": "next start",
    "type-check": "tsc --noemit",
    "check:package": "publint --strict && attw --pack ."
  },
  "types": "./dist/index.d.ts",
  "version": "2.0.0",
  "module": "./dist/index.js",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "typesVersions": {
    "*": {
      "client": [
        "./dist/client.d.ts"
      ]
    }
  },
  "packageManager": "pnpm@12.8.2"
}
