{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "incremental": false,
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": false,
    "outDir": "dist",
    "sourceMap": true,
    "target": "ES2022"
  },
  "exclude": [
    "src/app/**/*",
    "src/proxy.ts",
    "**/*.test.ts",
    "**/*.spec.ts"
  ],
  "extends": "./tsconfig.json",
  "include": [
    "src/utils/next-subrouter/index.ts",
    "src/utils/next-subrouter/**/*.ts",
    "src/utils/next-subrouter/**/*.tsx"
  ]
}
